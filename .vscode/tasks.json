{
    // Ctrl+Shift+B: release build (target/release). The debug build: Ctrl+Shift+P → "Tasks: Run Task".
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build --release",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--release"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"],
            "presentation": {
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "cargo build (debug)",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "group": "build",
            "problemMatcher": ["$rustc"],
            "presentation": {
                "reveal": "always",
                "clear": true
            }
        }
    ]
}
